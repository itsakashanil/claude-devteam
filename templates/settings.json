{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Read(/**)",
      "Edit(/**)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Edit(/.claude/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git push --mirror*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
