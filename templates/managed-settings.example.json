{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(//ABSOLUTE/PATH/TO/PROJECT/.claude/**)",
      "Read(//ABSOLUTE/PATH/TO/SECRETS/**)"
    ],
    "ask": [
      "Edit(//ABSOLUTE/PATH/TO/PROJECT/CLAUDE.md)"
    ]
  },
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/PROJECT/.claude/hooks/guard_bash.py",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
